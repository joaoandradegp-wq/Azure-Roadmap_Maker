{
  "azure": {
    "organization": "UnidasLocadoras",
    "project": "Projeto Funil de Vendas Ongoing",
    "patEnvVar": "AZURE_DEVOPS_PAT",
    "apiVersion": "7.1"
  },

  "query": {
    "workItemTypes": ["Feature", "User Story", "Tech Story", "Sustentação", "Administrativo"],
    "areaPath": "Projeto Funil de Vendas Ongoing",
    "extraWiqlWhere": "[System.BoardLane] = 'LIVRE' AND [System.CreatedDate] >= '2026-01-01' AND [System.Tags] NOT CONTAINS 'Bug'"
  },

  "fields": {
    "id": "System.Id",
    "title": "System.Title",
    "type": "System.WorkItemType",
    "state": "System.State",
    "assignedTo": "System.AssignedTo",
    "iterationPath": "System.IterationPath",
    "tags": "System.Tags",
    "plannedStart": "Microsoft.VSTS.Scheduling.StartDate",
    "plannedEnd": "Microsoft.VSTS.Scheduling.TargetDate",
    "actualStart": "Microsoft.VSTS.Scheduling.StartDate",
    "closedDate": "Microsoft.VSTS.Common.ClosedDate"
  },

  "statusMapping": {
    "byState": {
      "New": "naoIniciado",
      "Refinement": "naoIniciado",
      "Refined": "naoIniciado",
      "Active": "noPrazo",
      "ReadyQA": "noPrazo",
      "inQA": "noPrazo",
      "Resolved": "noPrazo",
      "Closed": "noPrazo",
      "Removed": "pausado"
    },
    "byTag": {
      "Bloqueado": "atraso",
      "Blocked": "atraso",
      "Risco": "risco",
      "Pausado": "pausado"
    }
  },

  "timeline": {
    "granularity": "biweekly",
    "monthsBack": 3,
    "monthsForward": 3
  },

  "sprintCadence": {
    "referenceSprintNumber": 10,
    "referenceStart": "2026-08-10",
    "referenceEnd": "2026-08-21",
    "cadenceDays": 14
  },

  "project": {
    "title": "Roadmap de Projetos e Melhorias Funil de Vendas - Livre",
    "squad": "Vendas"
  }
}
